# Rust build artifacts
target/
**/target/

# Soroban / Stellar local state
.soroban/
.stellar/

# Environment files
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Fuzz corpora and transient test output (generated, not committed)
fuzz/corpus/
**/fuzz/corpus/
fuzz/artifacts/
**/fuzz/artifacts/
*.profraw
*.profdata

# Proptest regression inputs are intentionally tracked for deterministic replay
# (see docs/FUZZING.md). Only ignore non-text transient proptest output.
proptest-regressions/**/*.tmp
**/proptest-regressions/**/*.tmp
